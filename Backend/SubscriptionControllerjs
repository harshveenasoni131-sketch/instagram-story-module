const Subscription = require('./Models/Subscription');

// Automatically assign a Free plan when a user signs up
exports.assignFreePlan = async (userId) => {
  try {
    const existingSub = await Subscription.findOne({ userId });
    if (!existingSub) {
      const newSubscription = new Subscription({
        userId: userId,
        planName: 'Free',
        postLimit: 1,
        postsUsed: 0,
        status: 'active'
      });
      await newSubscription.save();
    }
  } catch (error) {
    console.error("Error assigning free plan:", error.message);
  }
};
